---
import Base from '../layouts/Base.astro';
import Formulario from '../components/Formulario.astro';
import { getTratamientos } from '../lib/contenido';
import { sitio } from '../lib/sitio';

const tratamientos = await getTratamientos();
const hoy = new Date().toISOString().slice(0, 10);
---

<Base titulo="Pedir cita" descripcion="Pide cita en la clínica dental: elige el motivo, el día y la franja que prefieres y te confirmamos por teléfono o correo.">
  <div class="contenedor cabecera-pagina">
    <h1>Pedir cita</h1>
    <p>Dinos cuándo te viene bien y te confirmamos la hora por teléfono o correo. Si es una urgencia, <a class="enlace" href="/urgencias/">llámanos</a> mejor.</p>
  </div>
  <section class="seccion" style="padding-top:24px">
    <div class="contenedor dos dos--desigual" style="align-items:start">
      <Formulario tipo="cita" salud boton="Solicitar la cita" mensajeOk="Solicitud recibida. Te confirmamos la hora en el próximo día laborable por teléfono o correo.">
        <div>
          <label for="c-tipo">Tipo de visita <span class="marca" aria-hidden="true">*</span></label>
          <select id="c-tipo" name="tipo_visita" required>
            <option value="">Elige una opción</option>
            <option value="primera">Primera visita de valoración</option>
            <option value="revision">Revisión o limpieza</option>
            <option value="tratamiento">Un tratamiento concreto</option>
            <option value="nino">Visita de un niño</option>
            <option value="otro">No lo sé</option>
          </select>
          <p class="error" data-error-para="tipo_visita"></p>
        </div>
        <div>
          <label for="c-trat">Tratamiento (si lo sabes)</label>
          <select id="c-trat" name="tratamiento"><option value="">Ninguno en concreto</option>{tratamientos.map((t) => <option value={t.id}>{t.data.nombre}</option>)}</select>
        </div>
        <div><label for="c-nombre">Nombre <span class="marca" aria-hidden="true">*</span></label><input id="c-nombre" name="nombre" type="text" autocomplete="name" required /><p class="error" data-error-para="nombre"></p></div>
        <div><label for="c-tel">Teléfono <span class="marca" aria-hidden="true">*</span></label><input id="c-tel" name="telefono" type="tel" autocomplete="tel" required pattern="[0-9 +]{9,}" title="Escribe un teléfono de al menos 9 cifras" /><p class="error" data-error-para="telefono"></p></div>
        <div><label for="c-email">Correo</label><input id="c-email" name="email" type="email" autocomplete="email" /></div>
        <div><label for="c-fecha">Día que prefieres</label><input id="c-fecha" name="fecha" type="date" min={hoy} /></div>
        <div>
          <label for="c-franja">Franja</label>
          <select id="c-franja" name="franja"><option value="">Me da igual</option><option value="manana">Por la mañana</option><option value="tarde">Por la tarde</option></select>
        </div>
        <div>
          <label for="c-seguro">¿Tienes seguro dental?</label>
          <select id="c-seguro" name="seguro"><option value="">Prefiero decirlo después</option><option value="no">No</option><option value="si">Sí</option></select>
        </div>
        <div class="ancho-total">
          <label for="c-motivo">Cuéntanos brevemente el motivo (opcional)</label>
          <textarea id="c-motivo" name="motivo" maxlength="400" aria-describedby="c-motivo-ayuda"></textarea>
          <p class="ayuda" id="c-motivo-ayuda">Con una frase basta, por ejemplo «revisión» o «me duele una muela». No hace falta que nos cuentes detalles de tu salud: lo hablamos en la consulta. Si te da miedo el dentista, puedes decirlo aquí.</p>
        </div>
      </Formulario>
      <aside>
        <h2 style="font-size:1.7rem">Prefieres llamar</h2>
        <p><a class="enlace" href={`tel:${sitio.telefono}`}>{sitio.telefonoVisible}</a><br />Horario de lunes a jueves y viernes por la mañana.</p>
        <h2 style="font-size:1.7rem;margin-top:1.4em">Qué pasa después</h2>
        <ul class="lista">
          <li>Te llamamos o escribimos para confirmar la hora.</li>
          <li>Te recordamos qué traer.</li>
          <li>Si necesitas cambiarla, avísanos con tiempo.</li>
        </ul>
        <p class="letra-pequena">Esta solicitud no es una cita confirmada hasta que te contestemos.</p>
      </aside>
    </div>
  </section>
</Base>

<script>
  // Rellena el tratamiento y el aviso de miedo si vienen en la dirección (?tratamiento=...&miedo=1)
  const q = new URLSearchParams(location.search);
  const trat = document.getElementById('c-trat') as HTMLSelectElement | null;
  const tipo = document.getElementById('c-tipo') as HTMLSelectElement | null;
  const motivo = document.getElementById('c-motivo') as HTMLTextAreaElement | null;
  if (trat && q.get('tratamiento')) { trat.value = q.get('tratamiento')!; if (tipo) tipo.value = 'tratamiento'; }
  if (motivo && q.get('miedo')) motivo.value = 'Me da miedo el dentista.';
</script>
